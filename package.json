{
  "name": "intelliviajes-workspace",
  "private": true,
  "packageManager": "npm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test:smoke": "node tools/smoke-test.mjs",
    "ci:check": "npm run lint && npm run build && npm run test:smoke",
    "db:push:all": "node tools/db-push-all.mjs"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
